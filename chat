<!DOCTYPE html>
<html>
<head>
    <title>簡單聊天室</title>
    <style>
        /* 保持之前的CSS樣式 */
    </style>
</head>
<body>
    <div class="chat-container">
        <div class="chat-header">簡單聊天室</div>
        <div class="chat-messages" id="chat-messages"></div>
        <div class="chat-input">
            <input type="text" id="message-input" placeholder="輸入消息...">
            <button id="send-button">發送</button>
        </div>
    </div>

    <script>
        const pbUrl = 'http://localhost:8090'; // PocketBase地址
        
        // 收集消息
        async function loadMessages() {
            const response = await fetch(`${pbUrl}/api/collections/messages/records`);
            const data = await response.json();
            data.items.forEach(msg => {
                addMessage(msg.username, msg.content);
            });
        }
        
        // 發送消息
        async function sendMessage() {
            const input = document.getElementById('message-input');
            const username = prompt('你的名字?') || '匿名';
            
            await fetch(`${pbUrl}/api/collections/messages/records`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    username: username,
                    content: input.value
                })
            });
            
            input.value = '';
        }
        
        // 添加消息到界面
        function addMessage(username, content) {
            const div = document.createElement('div');
            div.className = 'message';
            div.innerHTML = `<strong>${username}:</strong> ${content}`;
            document.getElementById('chat-messages').appendChild(div);
        }
        
        // 設置事件監聽
        document.getElementById('send-button').addEventListener('click', sendMessage);
        
        // 初始加載
        loadMessages();
        // 簡單輪詢新消息
        setInterval(loadMessages, 2000);
    </script>
</body>
</html>
